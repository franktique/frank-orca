{
  "info": {
    "name": "smoke-plan",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Preflight",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{host}}/health",
              "host": ["{{host}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Setup",
      "item": [
        {
          "name": "Create case",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/cases",
              "host": ["{{host}}"],
              "path": ["cases"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"tenantId\": \"{{tenantId}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.environment.set(\"caseId\", pm.response.json().id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Scenarios",
      "item": [
        {
          "name": "SC-1 Bulk create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/bulk",
              "host": ["{{host}}"],
              "path": ["bulk"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"caseId\": \"{{caseId}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
          "name": "SC-4 Duplicate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/duplicate",
              "host": ["{{host}}"],
              "path": ["duplicate"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"caseId\": \"{{caseId}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 422\", function () { pm.response.to.have.status(422); });"
                ]
              }
            }
          ]
        },
        {
          "name": "SC-14 Race A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/race",
              "host": ["{{host}}"],
              "path": ["race"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"caseId\": \"{{caseId}}\"}"
            }
          }
        },
        {
          "name": "SC-14 Race B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{host}}/race",
              "host": ["{{host}}"],
              "path": ["race"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"caseId\": \"{{caseId}}\"}"
            }
          }
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete case",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{host}}/cases/{{caseId}}",
              "host": ["{{host}}"],
              "path": ["cases", "{{caseId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 204\", function () { pm.response.to.have.status(204); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
